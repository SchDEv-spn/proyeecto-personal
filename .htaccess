# Comprimir texto. La landing pinta los 1.091 municipios del pais dentro
# del propio HTML — es lo que permite que el formulario se pueda llenar sin
# JavaScript — y sin compresion eso son 137 KB de mas por visita. Comprimido
# baja a unos 11 KB, bastante menos que los 192 KB del JSON que reemplaza.
# El IfModule lo vuelve inofensivo donde el modulo no este cargado.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Caché larga solo para peticiones versionadas (?v=<filemtime>, ver
# asset_url() en app/helpers.php). Sin el ?v= no se manda esta cabecera:
# cachear un año sin forma de invalidar rompería el siguiente deploy.
<IfModule mod_headers.c>
    <If "%{QUERY_STRING} =~ /(^|&)v=/">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
</IfModule>

RewriteEngine On

# Redirigir slug obsoleto a slug nuevo (301 permanente)
RewriteRule ^producto/bolso-110000/?$ /producto/bolso-cuero-vegano [R=301,L]

# Servir uploads desde almacenamiento persistente fuera de public_html
RewriteRule ^public/uploads/(.+)$ serve-upload.php?f=$1 [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

RewriteRule ^(.+)$ index.php?url=$1 [QSA,L]
