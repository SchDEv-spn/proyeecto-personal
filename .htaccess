RewriteEngine On

# Redirigir slug obsoleto a slug nuevo (301 permanente)
RewriteRule ^producto/bolso-110000/?$ /producto/bolso-cuero-vegano [R=301,L]

# Servir uploads desde almacenamiento persistente fuera de public_html
RewriteRule ^public/uploads/(.+)$ serve-upload.php?f=$1 [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

RewriteRule ^(.+)$ index.php?url=$1 [QSA,L]
